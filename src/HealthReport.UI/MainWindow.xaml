<Window x:Class="HealthReport.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HealthReport.UI.ViewModels"
        xmlns:views="clr-namespace:HealthReport.UI.Views"
        mc:Ignorable="d"
        Title="HealthReport — Análisis de Apple Health con IA Local"
        Height="760" Width="1100" MinWidth="900" MinHeight="620"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Colores base -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#C50F1F"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE1E6"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6B6B"/>

        <!-- Botón primario -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E8EAED"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D2D5DA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón éxito -->
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#107C10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0B5E0B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card surface -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox limpio -->
        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#CDD1D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox limpio -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#CDD1D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Config -->
            <RowDefinition Height="Auto"/>  <!-- Barra de progreso -->
            <RowDefinition Height="*"/>     <!-- Contenido principal -->
            <RowDefinition Height="Auto"/>  <!-- Pie -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" Background="#0078D4" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🩺 HealthReport" FontSize="20" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Analiza tus datos de Apple Health con IA local (Ollama) — privado y offline"
                               FontSize="11" Foreground="#BEE0FF" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ PANEL DE CONFIGURACIÓN ══════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,12,16,0" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Archivo ZIP -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📁  Archivo ZIP de Apple Health"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#444"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ZipFilePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Style="{StaticResource CleanTextBox}"
                                 Foreground="#555"/>
                        <Button Grid.Column="2" Content="Examinar…"
                                Command="{Binding SelectZipFileCommand}"
                                Style="{StaticResource SecondaryBtn}"/>
                    </Grid>
                </StackPanel>

                <!-- Ollama URL + modelo -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="🤖  Modelo de IA local (Ollama)"
                               FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#444"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding OllamaUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CleanTextBox}"/>
                        <Button Grid.Column="2" Content="Conectar"
                                Command="{Binding LoadModelsCommand}"
                                Style="{StaticResource SecondaryBtn}"/>
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"/>
                    </Grid>
                </StackPanel>

                <!-- Días + Botones de acción -->
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Días:" VerticalAlignment="Center" FontSize="12" Foreground="#555"/>
                        <Slider Width="80" Minimum="30" Maximum="365"
                                Value="{Binding AnalysisDays}"
                                TickFrequency="30" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBlock Text="{Binding AnalysisDays}" Width="30"
                                   VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶  Analizar"
                                Command="{Binding StartAnalysisCommand}"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,0,8,0"/>
                        <Button Content="✕"
                                Command="{Binding CancelAnalysisCommand}"
                                Style="{StaticResource SecondaryBtn}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                ToolTip="Cancelar análisis"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ BARRA DE PROGRESO ══════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,8,16,0" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" Foreground="#444" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}"
                               HorizontalAlignment="Right" FontSize="12"
                               FontWeight="SemiBold" Foreground="#0078D4"/>
                </Grid>
                <ProgressBar Grid.Row="1" Value="{Binding ProgressValue}" Maximum="100"
                             Height="6" BorderThickness="0"
                             Foreground="#0078D4" Background="#E0EEFF"/>
                <!-- Error detail -->
                <Border Grid.Row="2" Background="#FFF4F4" CornerRadius="4" Padding="10,6"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorDetail}" FontSize="11"
                               Foreground="#C50F1F" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════ CONTENIDO PRINCIPAL (TabControl) ══════════════════ -->
        <TabControl Grid.Row="3" Margin="16,8,16,0"
                    Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </TabControl.Resources>

            <!-- ── Pestaña Análisis ── -->
            <TabItem Header="📋  Análisis">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel lateral: lista de fases como ListBox -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Fases del análisis"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#555"
                                       Padding="14,12,14,8"/>
                            <Separator DockPanel.Dock="Top" Background="#EEE" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding Phases}"
                                     SelectedItem="{Binding SelectedPhase}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="PhaseList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EBF3FB"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F9FD"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StatusIcon}" FontSize="14"
                                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               Foreground="{Binding StatusColor}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock FontSize="10" Foreground="#C50F1F"
                                                           TextWrapping="Wrap" Margin="22,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding ErrorMessage}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Panel de texto con auto-scroll -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#FAFAFA"
                                    BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <TextBlock Text="Resultado del análisis"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#333" VerticalAlignment="Center"/>
                                    <!-- Botones guardar (solo visible cuando hay resultados) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding AnalysisComplete, Converter={StaticResource BoolToVis}}">
                                        <Button Content="💾  Guardar MD"
                                                Command="{Binding SaveReportCommand}"
                                                Style="{StaticResource SuccessBtn}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="📄  Exportar PDF"
                                                Command="{Binding SavePdfCommand}"
                                                Style="{StaticResource PrimaryBtn}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="AnalysisScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="20,16">
                                <TextBlock Text="{Binding AnalysisText}"
                                           FontSize="13.5" LineHeight="22"
                                           TextWrapping="Wrap"
                                           FontFamily="Segoe UI"
                                           Foreground="#1A1A1A"
                                           x:Name="AnalysisTextBlock"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Pestaña Gráficos ── -->
            <TabItem Header="📈  Gráficos de tendencias">
                <views:ChartsView/>
            </TabItem>
        </TabControl>

        <!-- ══════════════════ PIE ══════════════════ -->
        <TextBlock Grid.Row="4" Margin="0,6,0,8"
                   Text="🔒  Tus datos nunca salen de tu equipo. HealthReport analiza todo localmente con Ollama."
                   FontSize="10" Foreground="#AAA" HorizontalAlignment="Center"/>
    </Grid>
</Window>
